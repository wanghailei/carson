#!/usr/bin/env bash
# Carson command guard — Claude Code PreToolUse hook.
#
# Blocks raw GitHub CLI commands in Carson-governed repositories when Carson
# provides a named stream for the same duty.
#
# Claude Code sends JSON on stdin: {"tool_name": "Bash", "tool_input": {"command": "..."}}
# To block: print reason to stderr, exit 2.
# To allow: exit 0.
#
# Registration in ~/.claude/settings.json:
#   "PreToolUse": [
#     {
#       "matcher": "Bash",
#       "hooks": [
#         {
#           "type": "command",
#           "command": "~/.carson/hooks/command-guard"
#         }
#       ]
#     }
#   ]
set -euo pipefail

# Read the tool call JSON from stdin.
input="$(cat)"

# Only inspect Bash tool calls.
tool_name="$(echo "$input" | jq -r '.tool_name // empty' 2>/dev/null)"
[ "$tool_name" = "Bash" ] || exit 0

command_text="$(echo "$input" | jq -r '.tool_input.command // empty' 2>/dev/null)"
[ -n "$command_text" ] || exit 0

# Check for gh commands that Carson replaces.
# Match only at command position: start of line, or after a shell operator (&&, ||, ;, |).
# This avoids false positives from gh references inside commit messages or string arguments.
deliver_pattern='(^|&&|\|\||;|\|)\s*gh\s+pr\s+(create|merge)\b'
track_pattern='(^|&&|\|\||;|\|)\s*gh\s+issue\s+(create|comment|close|reopen)\b'
review_pattern='(^|&&|\|\||;|\|)\s*gh\s+pr\s+(comment|review)\b'

replacement=""
if echo "$command_text" | grep -qE "$deliver_pattern"; then
	replacement="carson deliver"
elif echo "$command_text" | grep -qE "$track_pattern"; then
	replacement="carson track"
elif echo "$command_text" | grep -qE "$review_pattern"; then
	replacement="carson review"
else
	exit 0
fi

# Check if the current directory is inside a governed repository.
config_file="${HOME}/.carson/config.json"
[ -f "$config_file" ] || exit 0

repo_root="$(git rev-parse --show-toplevel 2>/dev/null || echo "")"
[ -n "$repo_root" ] || exit 0

normalised="$(cd "$repo_root" && pwd -P)"
if ! grep -qF "\"$normalised\"" "$config_file" 2>/dev/null; then
	exit 0
fi

# This is a raw gh command in a governed repo — block it.
echo "This repo is Carson-governed — use \`${replacement}\` instead of raw \`gh\`." >&2
echo "Use \`${replacement}\` instead — Carson owns this workflow." >&2
exit 2
